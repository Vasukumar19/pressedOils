generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  COD_PENDING
  PAID
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum FulfilmentMethod {
  DELIVERY
  STORE_PICKUP
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum CouponType {
  PERCENT
  FLAT
}

enum AdminRole {
  OWNER
  STAFF
}

model Product {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  description   String
  best_for      String
  origin_region String
  hsn_code      String?
  is_active     Boolean        @default(false)
  sort_order    Int            @default(0)
  brand         String         @default("[YOUR BRAND]")
  created_at    DateTime       @default(now()) @db.Timestamptz(3)
  updated_at    DateTime       @updatedAt @db.Timestamptz(3)
  images        ProductImage[]
  variants      Variant[]
  batches       Batch[]

  @@index([is_active, sort_order])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  url        String
  alt        String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, sort_order])
  @@map("product_images")
}

model Variant {
  id                  String          @id @default(uuid())
  product_id          String
  sku                 String          @unique
  size_label          String
  price_paise         Int
  mrp_paise           Int
  stock               Int             @default(0)
  reserved            Int             @default(0)
  low_stock_threshold Int             @default(5)
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now()) @db.Timestamptz(3)
  updated_at          DateTime        @updatedAt @db.Timestamptz(3)
  product             Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  batches             Batch[]
  order_items         OrderItem[]
  stock_movements     StockMovement[]
  reservations        Reservation[]

  @@index([product_id, is_active])
  @@map("variants")
}

model Batch {
  id                  String      @id @default(uuid())
  product_id          String
  variant_id          String?
  batch_no            String
  pressed_on          DateTime    @db.Date
  best_before         DateTime    @db.Date
  lab_report_url      String?
  lab_report_key      String?
  lab_report_checksum String?
  lab_tested_on       DateTime?   @db.Date
  is_current          Boolean     @default(false)
  is_active           Boolean     @default(true)
  locked_at           DateTime?   @db.Timestamptz(3)
  created_at          DateTime    @default(now()) @db.Timestamptz(3)
  updated_at          DateTime    @updatedAt @db.Timestamptz(3)
  product             Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  variant             Variant?    @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  order_items         OrderItem[]

  @@unique([product_id, batch_no])
  @@index([batch_no])
  @@index([product_id, is_active])
  @@map("batches")
}

model Customer {
  id               String    @id @default(uuid())
  name             String
  phone            String    @unique
  email            String?
  consent_given_at DateTime? @db.Timestamptz(3)
  deleted_at       DateTime? @db.Timestamptz(3)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  updated_at       DateTime  @updatedAt @db.Timestamptz(3)
  addresses        Address[]
  orders           Order[]

  @@map("customers")
}

model Address {
  id          String   @id @default(uuid())
  customer_id String
  name        String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("addresses")
}

model PickupLocation {
  id                String   @id @default(uuid())
  name              String
  address           String
  hours             String
  prep_time_minutes Int      @default(120)
  is_active         Boolean  @default(true)
  is_sample         Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)
  orders            Order[]

  @@index([is_active, is_sample])
  @@map("pickup_locations")
}

model Order {
  id                       String                   @id @default(uuid())
  order_number             String                   @unique
  customer_id              String
  address_snapshot         Json
  subtotal_paise           Int
  shipping_paise           Int
  cod_fee_paise            Int                      @default(0)
  discount_paise           Int                      @default(0)
  tax_paise                Int                      @default(0)
  total_paise              Int
  coupon_code              String?
  fulfilment_method        FulfilmentMethod         @default(DELIVERY)
  pickup_location_id       String?
  pickup_code_hash         String?
  pickup_code_attempts     Int                      @default(0)
  pickup_code_locked_until   DateTime?                @db.Timestamptz(3)
  pickup_ready_at            DateTime?                @db.Timestamptz(3)
  pickup_last_collection_at  DateTime?                @db.Timestamptz(3)
  pickup_code_reissue_count  Int                      @default(0)
  pickup_code_last_sent_at   DateTime?                @db.Timestamptz(3)
  picked_up_at               DateTime?                @db.Timestamptz(3)
  phone_verified_at          DateTime?                @db.Timestamptz(3)
  dpdp_consent_at            DateTime?                @db.Timestamptz(3)
  dpdp_policy_version      String?
  marketing_consent        Boolean                  @default(false)
  needs_attention          Boolean                  @default(false)
  refunded_paise           Int                      @default(0)
  failed_payment_attempts  Int                      @default(0)
  checkout_token_hash      String?
  payment_method           PaymentMethod
  payment_status           PaymentStatus            @default(PENDING)
  order_status             OrderStatus              @default(PENDING_PAYMENT)
  tracking_url             String?
  created_at               DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at               DateTime                 @updatedAt @db.Timestamptz(3)
  customer                 Customer                 @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  pickup_location          PickupLocation?          @relation(fields: [pickup_location_id], references: [id], onDelete: Restrict)
  items                    OrderItem[]
  events                   OrderEvent[]
  payments                 Payment[]
  refunds                  Refund[]
  webhook_events           WebhookEvent[]
  notifications            NotificationLog[]
  stock_movements          StockMovement[]
  reservations             Reservation[]
  idempotency_keys         CheckoutIdempotencyKey[]

  @@index([customer_id, created_at])
  @@index([order_status, created_at])
  @@index([pickup_location_id])
  @@index([needs_attention, created_at])
  @@index([payment_method, order_status, created_at])
  @@map("orders")
}

model OrderItem {
  id                    String  @id @default(uuid())
  order_id              String
  variant_id            String
  batch_id              String?
  product_name_snapshot String
  size_snapshot         String
  qty                   Int
  unit_price_paise      Int
  discount_paise        Int     @default(0)
  order                 Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant               Variant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  batch                 Batch?  @relation(fields: [batch_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([batch_id])
  @@map("order_items")
}

model OrderEvent {
  id         String      @id @default(uuid())
  order_id   String
  status     OrderStatus
  note       String?
  actor      String
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  order      Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
  @@map("order_events")
}

model Payment {
  id                 String        @id @default(uuid())
  order_id           String
  gateway            String
  gateway_order_id   String?
  gateway_payment_id String?       @unique
  amount_paise       Int
  status             PaymentStatus @default(PENDING)
  raw_payload        Json?
  created_at         DateTime      @default(now()) @db.Timestamptz(3)
  updated_at         DateTime      @updatedAt @db.Timestamptz(3)
  order              Order         @relation(fields: [order_id], references: [id], onDelete: Restrict)
  refunds            Refund[]

  @@index([order_id])
  @@index([gateway_order_id])
  @@map("payments")
}

model WebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  event_id      String    @unique
  event_type    String
  payload_hash  String
  order_id      String?
  status        String
  raw_payload   Json
  error_message String?
  processed_at  DateTime? @db.Timestamptz(3)
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  order         Order?    @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@index([event_type, created_at])
  @@map("webhook_events")
}

model Refund {
  id                String   @id @default(uuid())
  order_id          String
  payment_id        String?
  gateway_refund_id String?  @unique
  idempotency_key   String?  @unique
  amount_paise      Int
  status            String
  reason            String
  initiated_by      String
  raw_payload       Json?
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  payment           Payment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@index([payment_id])
  @@map("refunds")
}

model StockMovement {
  id         String   @id @default(uuid())
  variant_id String
  delta      Int
  reason     String
  order_id   String?
  actor      String
  created_at DateTime @default(now()) @db.Timestamptz(3)
  variant    Variant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  order      Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([variant_id, created_at])
  @@index([order_id])
  @@map("stock_movements")
}

model Reservation {
  id         String            @id @default(uuid())
  order_id   String
  variant_id String
  qty        Int
  expires_at DateTime          @db.Timestamptz(3)
  status     ReservationStatus @default(PENDING)
  created_at DateTime          @default(now()) @db.Timestamptz(3)
  updated_at DateTime          @updatedAt @db.Timestamptz(3)
  order      Order             @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant    Variant           @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([status, expires_at])
  @@index([order_id])
  @@map("reservations")
}

model CheckoutIdempotencyKey {
  key           String   @id
  request_hash  String
  order_id      String?
  status_code   Int
  response_json Json
  expires_at    DateTime @db.Timestamptz(3)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  order         Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([expires_at])
  @@map("checkout_idempotency_keys")
}

model Coupon {
  id                 String     @id @default(uuid())
  code               String     @unique
  type               CouponType
  value              Int
  min_order_paise    Int        @default(0)
  max_discount_paise Int?
  expires_at         DateTime?  @db.Timestamptz(3)
  usage_limit        Int?
  used_count         Int        @default(0)
  is_active          Boolean    @default(true)
  created_at         DateTime   @default(now()) @db.Timestamptz(3)
  updated_at         DateTime   @updatedAt @db.Timestamptz(3)

  @@map("coupons")
}

model ServiceablePincode {
  pincode        String   @id
  city           String
  state          String
  delivery_days  Int
  cod_allowed    Boolean  @default(true)
  shipping_paise Int
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  @@map("serviceable_pincodes")
}

model Setting {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

model Admin {
  id                String     @id @default(uuid())
  email             String     @unique
  password_hash     String?
  must_set_password Boolean    @default(true)
  role              AdminRole  @default(STAFF)
  totp_secret       String?
  is_active         Boolean    @default(true)
  created_at        DateTime   @default(now()) @db.Timestamptz(3)
  updated_at        DateTime   @updatedAt @db.Timestamptz(3)
  audit_logs        AuditLog[]

  @@map("admins")
}

model AuditLog {
  id         String   @id @default(uuid())
  admin_id   String?
  action     String
  entity     String
  entity_id  String
  before     Json?
  after      Json?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  admin      Admin?   @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id, created_at])
  @@index([admin_id, created_at])
  @@map("audit_logs")
}

model NotificationLog {
  id                  String    @id @default(uuid())
  idempotency_key     String    @unique
  order_id            String?
  channel             String
  event               String
  template_id         String
  template_version    String
  provider            String
  provider_message_id String?
  masked_recipient    String
  status              String
  error_message       String?
  payload_summary     Json?
  sent_at             DateTime? @db.Timestamptz(3)
  delivered_at        DateTime? @db.Timestamptz(3)
  created_at          DateTime  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime  @updatedAt @db.Timestamptz(3)
  order               Order?    @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@index([provider_message_id])
  @@index([status, created_at])
  @@map("notifications")
}

model EmailSuppression {
  email_hash      String   @id
  masked_email    String
  reason          String
  source_provider String
  source_event_id String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  @@map("email_suppressions")
}

model OtpChallenge {
  id           String    @id @default(uuid())
  purpose      String
  phone_hash   String
  session_id   String
  code_hmac    String
  attempts     Int       @default(0)
  max_attempts Int       @default(5)
  expires_at   DateTime  @db.Timestamptz(3)
  consumed_at  DateTime? @db.Timestamptz(3)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone_hash, purpose, created_at])
  @@index([expires_at])
  @@map("otp_challenges")
}

model PhoneVerificationToken {
  id         String    @id @default(uuid())
  purpose    String
  token_hash String    @unique
  phone_hash String
  session_id String
  expires_at DateTime  @db.Timestamptz(3)
  used_at    DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone_hash, purpose])
  @@index([expires_at])
  @@map("phone_verification_tokens")
}
