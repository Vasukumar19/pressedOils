# Environment variables — copy to .env and fill in real values.
# Local dev only; never commit .env or use these values in production.

PORT=4000
NODE_ENV=development
APP_ENV=development
IS_PRODUCTION_DB=false

DATABASE_URL=postgresql://pressedoils:pressedoils_dev_password@localhost:5432/pressedoils?schema=public
REDIS_URL=redis://localhost:6379

# Optional: only used by bootstrap:prod in non-dev environments
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
