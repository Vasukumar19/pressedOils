# Environment variables — copy to .env and fill in real values.
# Local dev only; never commit .env or use these values in production.

PORT=4000
NODE_ENV=development
APP_ENV=development
IS_PRODUCTION_DB=false
SHOW_SAMPLE_DATA_BANNER=true
LOG_LEVEL=info

DATABASE_URL=postgresql://pressedoils:pressedoils_dev_password@localhost:5432/pressedoils?schema=public
REDIS_URL=redis://localhost:6379

# Exact comma-separated origin allowlist (never use '*')
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Express trust proxy setting: 'false' locally, '1' (hop count) or trusted subnet behind ALB/Cloudflare
TRUST_PROXY=false

# Public API operational tuning
MAX_QTY_PER_VARIANT=10
REDIS_COMMAND_TIMEOUT_MS=200
DB_POOL_LIMIT=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_SLOW_QUERY_MS=200
# Comma-separated CDN/storage hostnames allowed for production images & PDF lab reports
CDN_ALLOWED_HOSTS=cdn.example.com

# Signed anonymous session secret for cart rate limiting (min 16 chars; required in staging/production)
# CART_SESSION_SECRET=replace-with-strong-32-char-secret
# Protected owner settings endpoint secret prior to Phase 9 admin auth
# OWNER_SETTINGS_SECRET=replace-with-strong-owner-secret
# Server-side HMAC secret for 6-digit store pickup codes (min 16 chars; required in production)
# PICKUP_CODE_HMAC_SECRET=replace-with-strong-32-char-pickup-secret

# Payment gateway ('mock' allowed ONLY in development/staging; APP_ENV=production enforces 'razorpay')
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Staging only: required when APP_ENV=staging to gate /api/docs
# SWAGGER_USER=admin
# SWAGGER_PASSWORD=change-me-strong-password
# SWAGGER_IP_ALLOWLIST=127.0.0.1

# Optional: only used by bootstrap:prod
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
