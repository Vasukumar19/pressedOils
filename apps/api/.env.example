# Environment variables — copy to .env and fill in real values.
# Local dev only; never commit .env or use these values in production.

PORT=4000
NODE_ENV=development
APP_ENV=development
IS_PRODUCTION_DB=false
SHOW_SAMPLE_DATA_BANNER=true
LOG_LEVEL=info

DATABASE_URL=postgresql://pressedoils:pressedoils_dev_password@localhost:5432/pressedoils?schema=public
# Cache + rate-limiting Redis (volatile-lru eviction allowed)
REDIS_URL=redis://localhost:6379
# Dedicated BullMQ queue Redis (MUST use --maxmemory-policy noeviction + AOF persistence)
QUEUE_REDIS_URL=redis://localhost:6380

# Exact comma-separated origin allowlist (never use '*')
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Express trust proxy setting: 'false' locally, '1' (hop count) or trusted subnet behind ALB/Cloudflare
TRUST_PROXY=false

# Public API operational tuning
MAX_QTY_PER_VARIANT=10
REDIS_COMMAND_TIMEOUT_MS=200
DB_POOL_LIMIT=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_SLOW_QUERY_MS=200
# Comma-separated CDN/storage hostnames allowed for production images & PDF lab reports
CDN_ALLOWED_HOSTS=cdn.example.com

# Signed anonymous session secret for cart rate limiting (min 16 chars; required in staging/production)
# CART_SESSION_SECRET=replace-with-strong-32-char-secret
# Protected owner settings endpoint secret prior to Phase 9 admin auth
# OWNER_SETTINGS_SECRET=replace-with-strong-owner-secret
# Server-side HMAC secret for 6-digit store pickup codes (min 16 chars; required in production)
# PICKUP_CODE_HMAC_SECRET=replace-with-strong-32-char-pickup-secret

# Payment gateway ('mock' allowed ONLY in development/staging; APP_ENV=production enforces 'razorpay')
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Temporary pre-Phase-9 admin endpoints (/api/admin/*): strictly disabled in production
ENABLE_TEMP_ADMIN_API=true
# TEMP_ADMIN_IP_ALLOWLIST=127.0.0.1

# Operational alerting (critical webhook mismatches, unexpected refunds, dead-letter jobs, low SMS balance)
# OWNER_ALERT_EMAIL=owner@example.com,ops@example.com
# OWNER_ALERT_PHONE=+919876543210
# UPTIME_ALERT_WEBHOOK_URL=https://uptime.example.com/webhook/incident
# SENTRY_DSN=https://...

# Notifications & OTP ('mock' allowed ONLY in development/staging; APP_ENV=production enforces msg91 + resend)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
# OTP_HMAC_SECRET=replace-with-strong-32-char-otp-hmac-secret
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=PROILS
# MSG91_WEBHOOK_SECRET=replace-with-msg91-webhook-secret
# MSG91_DLT_TEMPLATE_OTP=dlt_template_id_otp
# MSG91_DLT_TEMPLATE_ORDER_CONFIRMED=dlt_template_id_confirmed
# MSG91_DLT_TEMPLATE_ORDER_SHIPPED=dlt_template_id_shipped
# MSG91_DLT_TEMPLATE_ORDER_DELIVERED=dlt_template_id_delivered
# MSG91_DLT_TEMPLATE_ORDER_READY_FOR_PICKUP=dlt_template_id_ready_pickup
# MSG91_DLT_TEMPLATE_PICKUP_CODE=dlt_template_id_pickup_code
# MSG91_DLT_TEMPLATE_OWNER_ALERT=dlt_template_id_owner_alert
# MSG91_DLT_TEMPLATE_ORDER_UPDATE=dlt_template_id_order_update
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM="Pressed Oils <orders@yourdomain.com>"
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
SMS_LOW_BALANCE_THRESHOLD=500

# Anti-bot Turnstile CAPTCHA triggered on repeated OTP requests
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Staging only: required when APP_ENV=staging to gate /api/docs
# SWAGGER_USER=admin
# SWAGGER_PASSWORD=change-me-strong-password
# SWAGGER_IP_ALLOWLIST=127.0.0.1

# Optional: only used by bootstrap:prod
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
