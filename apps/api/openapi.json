{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_checkLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API process is alive"
          }
        },
        "summary": "Liveness probe — confirms the API process is running",
        "tags": ["health"]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "HealthController_checkReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database is reachable (Redis may be ok or degraded)"
          },
          "503": {
            "description": "Database is unreachable"
          }
        },
        "summary": "Readiness probe — depends on PostgreSQL only; reports Redis degraded with HTTP 200",
        "tags": ["health"]
      }
    },
    "/api/products": {
      "get": {
        "operationId": "ProductsController_list",
        "parameters": [
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["featured", "price_asc", "price_desc", "newest"],
              "type": "string"
            }
          },
          {
            "name": "maxPricePaise",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minPricePaise",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["500 ml", "1 L", "5 L"],
              "type": "string"
            }
          },
          {
            "name": "inStockOnly",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated active product catalog"
          },
          "400": {
            "description": "Invalid or unknown query parameters"
          }
        },
        "summary": "List active products with filters, sorting, and pagination",
        "tags": ["products"]
      }
    },
    "/api/products/availability": {
      "get": {
        "operationId": "ProductsController_availability",
        "parameters": [
          {
            "name": "variantIds",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Variant availability and max order qty cap"
          }
        },
        "summary": "Fetch live variant availability (no HTTP caching)",
        "tags": ["products"]
      }
    },
    "/api/products/{slug}": {
      "get": {
        "operationId": "ProductsController_getBySlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "example": "groundnut-oil",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail with variants and current batch"
          },
          "404": {
            "description": "Product not found"
          }
        },
        "summary": "Get active product detail by slug",
        "tags": ["products"]
      }
    },
    "/api/pincode/{pincode}": {
      "get": {
        "operationId": "PincodeController_check",
        "parameters": [
          {
            "name": "pincode",
            "required": true,
            "in": "path",
            "schema": {
              "example": "600001",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Uniform serviceability shape for found and unserviceable pincodes"
          },
          "400": {
            "description": "Invalid 6-digit Indian pincode"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Check pincode serviceability, delivery days, COD, and shipping fee",
        "tags": ["pincode"]
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "SettingsController_getPublicSettings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Public store settings"
          }
        },
        "summary": "Get public store info, thresholds, and GST configuration",
        "tags": ["settings"]
      }
    },
    "/api/admin/settings": {
      "patch": {
        "operationId": "AdminSettingsController_updateSettings",
        "parameters": [
          {
            "name": "x-admin-email",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated public settings snapshot (audit logged)"
          },
          "403": {
            "description": "Forbidden: disabled in production, invalid secret, or non-OWNER admin"
          }
        },
        "summary": "Owner-only dev/staging settings switch (disabled in production until Phase 9 Admin 2FA)",
        "tags": ["admin-settings"]
      }
    },
    "/api/cart/validate": {
      "post": {
        "operationId": "CartController_validate",
        "parameters": [
          {
            "name": "x-cart-session",
            "in": "header",
            "description": "HMAC-signed anonymous cart session token issued by the API",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative server-computed cart breakdown"
          },
          "400": {
            "description": "Invalid input or unavailable store pickup selection"
          },
          "429": {
            "description": "Cart validation or invalid coupon rate limit exceeded"
          }
        },
        "summary": "Validate cart items, quantities, live PostgreSQL prices/stock, coupons, pincode shipping, and store pickup",
        "tags": ["cart"]
      }
    },
    "/api/checkout": {
      "post": {
        "operationId": "CheckoutController_createCheckout",
        "parameters": [
          {
            "name": "x-cart-session",
            "in": "header",
            "description": "Signed anonymous cart session token issued by API",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "description": "Unique client-generated key (16-128 chars) preventing duplicate order placement",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Order created (COD confirmed or Online payment session ready)"
          },
          "400": {
            "description": "Validation error, unserviceable pincode, or COD disallowed"
          },
          "403": {
            "description": "Checkout disabled in production until legal pages approved"
          },
          "409": {
            "description": "Insufficient stock or Idempotency-Key payload mismatch"
          },
          "429": {
            "description": "Checkout rate limit exceeded"
          }
        },
        "summary": "Place a COD/Pay-at-store order or initialize an Online payment with 15-minute stock reservation",
        "tags": ["checkout"]
      }
    },
    "/api/checkout/verify": {
      "post": {
        "operationId": "CheckoutController_verifyCheckoutPayment",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Payment verified and order marked PAID (or idempotent replay)"
          },
          "400": {
            "description": "Invalid signature or mismatched order payment reference"
          }
        },
        "summary": "Verify Razorpay HMAC payment signature and atomically transition order to PAID",
        "tags": ["checkout"]
      }
    },
    "/api/checkout/fail": {
      "post": {
        "operationId": "CheckoutController_failCheckoutPayment",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Pending stock reservation released cleanly"
          }
        },
        "summary": "Cancel pending checkout on gateway failure/dismissal and release reserved stock",
        "tags": ["checkout"]
      }
    },
    "/api/checkout/mock-complete": {
      "post": {
        "operationId": "CheckoutController_mockCompleteCheckoutPayment",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Non-production dev/staging helper to complete mock online payment (403 in production)",
        "tags": ["checkout"]
      }
    },
    "/api/webhooks/razorpay": {
      "post": {
        "operationId": "WebhooksController_handleRazorpayWebhook",
        "parameters": [
          {
            "name": "x-razorpay-event-id",
            "in": "header",
            "description": "Unique Razorpay event delivery identifier for strict idempotent deduplication",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-razorpay-signature",
            "in": "header",
            "description": "HMAC-SHA256 signature computed over the exact raw request body",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook verified and acknowledged"
          },
          "401": {
            "description": "Invalid or missing Razorpay webhook signature"
          }
        },
        "summary": "Receive and process Razorpay webhooks (verifies X-Razorpay-Signature over exact raw bytes first)",
        "tags": ["webhooks"]
      }
    },
    "/api/admin/orders/{id}/confirm": {
      "post": {
        "operationId": "AdminOrdersController_confirmOrder",
        "parameters": [
          {
            "name": "x-admin-email",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order confirmed cleanly"
          },
          "403": {
            "description": "Disabled in production or invalid admin credentials"
          }
        },
        "summary": "Temporary admin endpoint to transition a PAID or COD_PENDING order to CONFIRMED (disabled in prod)",
        "tags": ["admin-orders"]
      }
    },
    "/api/admin/orders/{id}/cancel": {
      "post": {
        "operationId": "AdminOrdersController_cancelOrder",
        "parameters": [
          {
            "name": "x-admin-email",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled and stock restored cleanly"
          },
          "409": {
            "description": "Order already cancelled; double-restock prevented"
          }
        },
        "summary": "Cancel an unshipped order, restore stock ONCE, write AuditLog, and initiate refund if paid (disabled in prod)",
        "tags": ["admin-orders"]
      }
    },
    "/api/admin/orders/{id}/refund": {
      "post": {
        "operationId": "AdminOrdersController_refundOrder",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-email",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Refund initiated (or idempotent replay)"
          }
        },
        "summary": "Initiate a full or partial Razorpay refund with Idempotency-Key; finalized by refund.processed webhook (disabled in prod)",
        "tags": ["admin-orders"]
      }
    },
    "/api/admin/orders/{id}/return-stock": {
      "post": {
        "operationId": "AdminOrdersController_returnOrderStock",
        "parameters": [
          {
            "name": "x-admin-email",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-admin-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return stock inspection recorded cleanly"
          }
        },
        "summary": "Record inspected physical return stock (sealed restock vs damaged write-off) on post-shipment orders (disabled in prod)",
        "tags": ["admin-orders"]
      }
    }
  },
  "info": {
    "title": "[YOUR BRAND] Public API",
    "description": "Single-brand cold-pressed oil storefront & operations API",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "products",
      "description": "Catalog, product detail, and live availability"
    },
    {
      "name": "cart",
      "description": "Server cart validation, pricing, coupons, and fulfilment checks"
    },
    {
      "name": "checkout",
      "description": "Checkout, inventory reservations, COD, and Razorpay verification"
    },
    {
      "name": "webhooks",
      "description": "Verified payment gateway webhooks (raw-body HMAC + replay idempotency)"
    },
    {
      "name": "pincode",
      "description": "Delivery serviceability, TAT, COD, and shipping fees"
    },
    {
      "name": "settings",
      "description": "Public store configuration and thresholds"
    },
    {
      "name": "admin-settings",
      "description": "Protected owner settings controls (pre-Phase 9)"
    },
    {
      "name": "admin-orders",
      "description": "Protected dev/staging order cancel, refund & return actions (pre-Phase 9)"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
