{
  "name": "@pressedoils/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "seed:dev": "tsx prisma/seed.dev.ts",
    "bootstrap:prod": "tsx prisma/bootstrap.prod.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.dev.ts",
    "check:no-placeholders": "tsx scripts/check-no-placeholders.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pressedoils/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.7"
  }
}
